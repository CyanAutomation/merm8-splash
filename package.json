    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.6",
    "@types/node": "^26.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9",
    "globals": "^14.0.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
