{
  "name": "merm8-splash",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "npm run lint && NODE_ENV=test npm test && npm run build",
